  m_Script: {fileID: 11500000, guid: 4559966efa26ba04082181d46532a9c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  outline: {fileID: 1368926440}
  interactionIndicator: {fileID: 1984540456}
  canInteract: 1
  signCanvas: {fileID: 194788577}
  signText: {fileID: 234036259}
  message: "\xA1Atenci\xF3n! Combate final pr\xF3ximo\n\nEst\xE1s a punto de enfrentarte
    al enemigo m\xE1s peligroso de la zona.\nEste jefe cambia constantemente entre
    diferentes colores, y solo podr\xE1 recibir da\xF1o cuando ataques usando la
    carga correcta. Si usas la carga equivocada, tus ataques no tendr\xE1n efecto.\n\nPero
    cuidado: cada vez que logres golpearlo 5 veces correctamente, liberar\xE1 un
    poderoso rayo l\xE1ser capaz de atravesar el \xE1rea y ponerte en peligro.\n\nObserva
    sus cambios, reacciona r\xE1pido y utiliza bien tus habilidades para detener
    la contaminaci\xF3n de una vez por todas."
  triggersEnding: 0
  endingSequence: {fileID: 0}
