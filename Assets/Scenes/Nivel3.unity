  interactionIndicator: {fileID: 544293424}
  canInteract: 1
  signCanvas: {fileID: 194788577}
  signText: {fileID: 234036259}
  message: "Objetivo de la zona:\r\nPara purificar el agua y poder avanzar, debes
    reparar las tuber\xEDas da\xF1adas usando los tres objetos que se encuentran
    en el mapa: **tornillo, v\xE1lvula y llave inglesa**.\r\n\r\nAdem\xE1s, tendr\xE1s
    que activar correctamente las m\xE1quinas de purificaci\xF3n en el siguiente
    orden:\r\n\r\n1. Desarenadores\r\n2. Floculadores\r\n3. Decantadores\r\n4. Filtros
    de arena/carb\xF3n\r\n5. Bombas dosificadoras\r\n\r\nCuando completes ambos procesos,
    el agua ser\xE1 purificada y podr\xE1s continuar tu camino.\r\n"
  triggersEnding: 0
  endingSequence: {fileID: 0}
