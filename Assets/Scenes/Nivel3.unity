  signCanvas: {fileID: 194788577}
  signText: {fileID: 234036259}
  message: "\xA1Excelente trabajo! Gracias a tus acciones, el entorno ha comenzado
    a recuperarse. Clasificaste correctamente los residuos, administraste responsablemente
    la energ\xEDa y ayudaste a descontaminar el agua, demostrando que peque\xF1as
    acciones pueden generar grandes cambios.\n\nLa naturaleza vuelve a respirar,
    el agua fluye m\xE1s limpia y el ambiente es ahora un lugar mejor para todos.
    Sigue cuidando el planeta y recuerda: cada decisi\xF3n cuenta cuando se trata
    de proteger nuestro medio ambiente"
  triggersEnding: 1
  endingSequence: {fileID: 1557884661}
